#!/bin/sh
# postinst script for mirrorix
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        echo ""
        echo "=========================================================================="
        echo " Mirrorix installed successfully!"
        echo "=========================================================================="
        echo ""
        echo " First-time setup instructions:"
        echo " 1. Make sure your Android device is connected via USB for the first time."
        echo " 2. Ensure USB Debugging is enabled in Developer Options."
        echo " 3. Run 'mirrorix' from your terminal or launch it from your application menu."
        echo " 4. Mirrorix will handle connecting via WiFi. Once paired, you can disconnect the USB cable."
        echo ""
        echo " Note: Your user needs permission to use adb. If devices are not detected,"
        echo " ensure you are in the plugdev group or run adb as root."
        echo "=========================================================================="
        echo ""
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
